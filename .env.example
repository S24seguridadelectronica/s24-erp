# ============================================================
# S24 PLATFORM - SCRIPT DE INICIALIZACIÓN (FASE 2)
# Sistema Integral ERP + CRM + CMS + Call Center
# ============================================================

$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "  S24 PLATFORM - INICIALIZACIÓN DEL PROYECTO" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host ""

# ------------------------------------------------------------
# PASO 1: Verificar prerequisitos
# ------------------------------------------------------------
Write-Host "[1/10] Verificando prerequisitos..." -ForegroundColor Yellow

try {
    $nodeVersion = node --version
    $npmVersion = npm --version
    $gitVersion = git --version
    Write-Host "  ✓ Node.js: $nodeVersion" -ForegroundColor Green
    Write-Host "  ✓ npm: $npmVersion" -ForegroundColor Green
    Write-Host "  ✓ Git: $gitVersion" -ForegroundColor Green
} catch {
    Write-Host "  ✗ Error: Faltan prerequisitos" -ForegroundColor Red
    exit 1
}

# ------------------------------------------------------------
# PASO 2: Inicializar proyecto con Vite
# ------------------------------------------------------------
Write-Host ""
Write-Host "[2/10] Inicializando proyecto con Vite + React + TypeScript..." -ForegroundColor Yellow

# Limpiar contenido previo si existe (excepto el script)
Get-ChildItem -Exclude "setup.ps1" | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue

# Crear proyecto Vite en directorio temporal y mover contenido
npm create vite@latest temp-project -- --template react-ts
if ($LASTEXITCODE -ne 0) {
    Write-Host "  ✗ Error al crear proyecto Vite" -ForegroundColor Red
    exit 1
}

# Mover contenido al directorio actual
Get-ChildItem -Path "temp-project" | Move-Item -Destination "." -Force
Remove-Item -Path "temp-project" -Recurse -Force -ErrorAction SilentlyContinue

Write-Host "  ✓ Proyecto Vite creado" -ForegroundColor Green

# ------------------------------------------------------------
# PASO 3: Instalar dependencias base
# ------------------------------------------------------------
Write-Host ""
Write-Host "[3/10] Instalando dependencias base..." -ForegroundColor Yellow

npm install
if ($LASTEXITCODE -ne 0) {
    Write-Host "  ✗ Error al instalar dependencias base" -ForegroundColor Red
    exit 1
}
Write-Host "  ✓ Dependencias base instaladas" -ForegroundColor Green

# ------------------------------------------------------------
# PASO 4: Instalar dependencias del proyecto
# ------------------------------------------------------------
Write-Host ""
Write-Host "[4/10] Instalando dependencias del proyecto..." -ForegroundColor Yellow

npm install react-router-dom@6 @supabase/supabase-js react-bootstrap bootstrap react-hook-form @hookform/resolvers zod @tanstack/react-query zustand date-fns react-icons lucide-react axios

if ($LASTEXITCODE -ne 0) {
    Write-Host "  ✗ Error al instalar dependencias del proyecto" -ForegroundColor Red
    exit 1
}
Write-Host "  ✓ Dependencias del proyecto instaladas" -ForegroundColor Green

# ------------------------------------------------------------
# PASO 5: Instalar dependencias de desarrollo
# ------------------------------------------------------------
Write-Host ""
Write-Host "[5/10] Instalando herramientas de desarrollo..." -ForegroundColor Yellow

npm install -D @types/node @types/react-bootstrap eslint prettier eslint-config-prettier eslint-plugin-react eslint-plugin-react-hooks @typescript-eslint/eslint-plugin @typescript-eslint/parser

if ($LASTEXITCODE -ne 0) {
    Write-Host "  ✗ Error al instalar herramientas de desarrollo" -ForegroundColor Red
    exit 1
}
Write-Host "  ✓ Herramientas de desarrollo instaladas" -ForegroundColor Green

# ------------------------------------------------------------
# PASO 6: Crear estructura de directorios
# ------------------------------------------------------------
Write-Host ""
Write-Host "[6/10] Creando estructura de directorios..." -ForegroundColor Yellow

$directories = @(
    "src\app",
    "src\components\common",
    "src\components\layout",
    "src\components\forms",
    "src\modules\dashboard\components",
    "src\modules\dashboard\hooks",
    "src\modules\crm\customers",
    "src\modules\crm\opportunities",
    "src\modules\crm\activities",
    "src\modules\call-center\components",
    "src\modules\call-center\services",
    "src\modules\sales\quotes",
    "src\modules\sales\sales",
    "src\modules\sales\commissions",
    "src\modules\operations\work-orders",
    "src\modules\operations\technicians",
    "src\modules\inventory\products",
    "src\modules\inventory\movements",
    "src\modules\inventory\suppliers",
    "src\modules\finance\transactions",
    "src\modules\finance\reports",
    "src\modules\cms\pages",
    "src\modules\cms\assets",
    "src\modules\cms\settings",
    "src\modules\admin\users",
    "src\modules\admin\roles",
    "src\modules\admin\audit-logs",
    "src\modules\reports\components",
    "src\modules\auth",
    "src\services\supabase",
    "src\services\api",
    "src\services\telephony",
    "src\hooks",
    "src\types",
    "src\utils",
    "src\styles",
    "src\assets\images",
    "supabase\functions\telephony-webhook",
    "supabase\functions\transcription-processor",
    "supabase\functions\ai-analyzer",
    "supabase\migrations",
    "scripts",
    "tests\unit",
    "tests\integration",
    "tests\e2e",
    "docs"
)

foreach ($dir in $directories) {
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
}
Write-Host "  ✓ Estructura de directorios creada" -ForegroundColor Green

# ------------------------------------------------------------
# PASO 7: Crear archivos de configuración
# ------------------------------------------------------------
Write-Host ""
Write-Host "[7/10] Creando archivos de configuración..." -ForegroundColor Yellow

# .env.example
@"
# ============================================================
# S24 PLATFORM - VARIABLES DE ENTORNO
# Copiar este archivo como .env y completar los valores
# ============================================================

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Telephony (Twilio)
VITE_TELEPHONY_PROVIDER=twilio
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_PHONE_NUMBER=

# AI Services
VITE_OPENAI_API_KEY=

# Application
VITE_APP_NAME=S24 Seguridad Electrónica
VITE_APP_TIMEZONE=America/Bogota
VITE_APP_CURRENCY=COP
